  m_Script: {fileID: 11500000, guid: c71376b311026b948bc207f23f23abdc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  canvas: {fileID: 2015707309}
  catKeeper: {fileID: 1131982867}
  catKeeperUI: {fileID: 1131982869}
  text: {fileID: 966757545}
  textBox: {fileID: 1718311653}
  catContainer: []
  textTypingSpeed: 100
  dialogueLifetime: 3
  defaultDialogueLifetime: 5
  dialogueTextChoices:
  - Hello Commander! Please lead us to victory!
  - Commander! Your cat is low on health!
  - No.. Your cat has fallen... Maybe we should retreat for now.....
  - Your on a roll! Keep it up!
  - Your Inventory is full Commander!
  - Please equip the correct item type!
  - You have to preview a cat before you can equip items!
  - You need at least one cat to enter battle. Go to Inventory and add cats to the
    team!
  - You do not have enough to purchase this, commander! We should clear out more
    inklings.
  - This upgrade is fully upgraded!
  - You do not have enough Cores. Hunt down stronger inklings and collect their cores.
    Cores allow you to summon rarer cats!
  tutorialTextChoices:
  - Come and talk to me and I will summon you cats to defend us!
  - Here is free 100 ink from me! You need this to summon for different types of
    cats. Press the summon button to summon our first defender!
  - Great! You have summoned our first cat! Tap the screen to continue!
  - You can return to the lobby by clicking on the close button at the top left.
  - We need to go to the inventory to add the cat to your team!
  - Drag and drop your cat into the team to bring them to battle!
  - Nice! The cat will fight for you in battle now! Return back to the lobby! We
    have to defend our base!
  - You can enter battle as long as you have at least one cat in your team! Let's
    go quickly now!
  - You can drag and drop cats to the circles to re-position them in battle!
  - Nice! Make sure to move your cats away from danger and keep your vulnerable cats
    to the back!
  - The retreat button is at the top right. Cats deaths are permanent! So if things
    get too dangerous, just retreat build a stronger team!
  - This is the retreat page. It displays all your earnings from this current run!
    Let head back to the car by pressing confirm.
  - Be sure to use your Inks you have collected to summon more cats or puchase upgrades!
    Click anywhere on the screen to finish the tutorial!
  dialogueQueue: []
  topLeftPosition: {fileID: 1942794289}
  bottomLeftPosition: {fileID: 1897579559}
  topRightPosition: {fileID: 665915344}
  addTeamPosition: {fileID: 771837168}
  isTalking: 0
